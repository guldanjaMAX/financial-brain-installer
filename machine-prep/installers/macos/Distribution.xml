<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>Financial Brain Machine Prep</title>
  <organization>com.financialbrain</organization>
  <domains enable_localSystem="false" enable_currentUserHome="true" enable_anywhere="false"/>
  <options customize="never" require-scripts="false" rootVolumeOnly="false" hostArchitectures="arm64,x86_64"/>
  <allowed-os-versions>
    <os-version min="13.5"/>
  </allowed-os-versions>
  <welcome file="Welcome.html" mime-type="text/html"/>
  <conclusion file="Conclusion.html" mime-type="text/html"/>
  <choices-outline>
    <line choice="default"/>
  </choices-outline>
  <choice id="default" visible="false">
    <pkg-ref id="com.financialbrain.machineprep"/>
  </choice>
  <pkg-ref id="com.financialbrain.machineprep" version="0.2.0">FinancialBrainMachinePrep-component.pkg</pkg-ref>
</installer-gui-script>
