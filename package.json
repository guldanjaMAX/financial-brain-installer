{
  "name": "brain-installer",
  "version": "0.4.7",
  "private": true,
  "description": "Provision and manage a client-owned retrieval brain inside their own Cloudflare account",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "brain": "./brain.mjs"
  },
  "scripts": {
    "field:prepare": "node scripts/field-prepare.mjs",
    "rehearse:hiccups": "node scripts/customer-hiccup-lab.mjs",
    "rehearse:onboarding": "node scripts/onboarding-sandbox.mjs",
    "privacy:history": "node scripts/scan-git-history-privacy.mjs --ref HEAD --require-clean",
    "privacy:history:remote": "node scripts/scan-git-history-privacy.mjs --remote origin --ref HEAD --require-clean",
    "privacy:history:strict": "node scripts/scan-git-history-privacy.mjs --remote origin --ref HEAD --require-clean",
    "test": "node scripts/run-test-chain.mjs",
    "test:eval": "node --test eval/brain-client.test.mjs eval/corpus-contract.test.mjs eval/golden-20.test.mjs eval/profile.test.mjs eval/run.test.mjs eval/scorer.test.mjs",
    "audit:updates": "node scripts/audit-updates.mjs --release",
    "audit:regressions": "node scripts/audit-updates.mjs --regressions",
    "test:release": "node scripts/test-release-workflow-contract.mjs && node test/update-audit.test.mjs && node test/install-page-version.test.mjs && node test/release-script-coverage.test.mjs"
  },
  "_files_comment": [
    "ALLOWLIST, deliberately. eval/ holds a golden question set built from the",
    "author's OWN brain, naming real clients, real prices and a child's school.",
    "A denylist would eventually miss something like that; an allowlist cannot.",
    "test/ and worker/test/ are excluded for size, not secrecy."
  ],
  "files": [
    "CHANGELOG.md",
    "README.md",
    "acceptance.mjs",
    "brain.mjs",
    "components/",
    "connectors/",
    "docs/ARCHITECTURE.md",
    "docs/COMPETITIVE-BENCHMARK.md",
    "docs/CONNECTOR-BACKLOG.md",
    "docs/ENGINEERING-STANDARDS.md",
    "docs/EVALUATION.md",
    "docs/LEGACY-SUPABASE-EXIT.md",
    "docs/MAINTAINER.md",
    "docs/OWNER-WORKSPACE-API.md",
    "docs/README-developer.md",
    "docs/RECOVERY.md",
    "docs/decisions/000-template.md",
    "docs/decisions/001-cloudflare-native-standard.md",
    "docs/decisions/002-paused-bootstrap-acceleration.md",
    "docs/decisions/003-staged-source-onboarding.md",
    "docs/decisions/004-version-scoped-release-scope.md",
    "docs/decisions/README.md",
    "doctor.mjs",
    "eval/brain-client.mjs",
    "eval/corpus-contract.mjs",
    "eval/eval.config.json",
    "eval/golden-20.mjs",
    "eval/golden-validation.mjs",
    "eval/golden/TEMPLATE.golden.json",
    "eval/profile.mjs",
    "eval/run.mjs",
    "eval/schema/corpus-contract-v1.schema.json",
    "eval/schema/eval-suite-v2.schema.json",
    "eval/schema/gate-policy-v1.schema.json",
    "eval/schema/run-artifact-v2.schema.json",
    "eval/scorer.mjs",
    "ingest/",
    "manifest.schema.json",
    "migrations/",
    "onboarding/",
    "operations/",
    "privacy/",
    "report-html.mjs",
    "report.mjs",
    "scripts/",
    "scripts/windows-dpapi-release-gate.mjs",
    "skills/",
    "support-journal.mjs",
    "support-recovery.mjs",
    "templates/",
    "worker/build-src/",
    "worker/src/",
    "tools/preflight.sh",
    "tools/preflight.ps1",
    "docs/UPDATE-AUDIT.md",
    "docs/update-incidents.json",
    "docs/PLAID-RELEASE-GATE.md"
  ],
  "dependencies": {
    "@e965/xlsx": "0.20.3",
    "fflate": "0.8.3",
    "postal-mime": "3.0.0",
    "unpdf": "1.8.1"
  },
  "bundleDependencies": [
    "@e965/xlsx",
    "fflate",
    "postal-mime",
    "unpdf"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guldanjaMAX/financial-brain-installer.git"
  }
}
