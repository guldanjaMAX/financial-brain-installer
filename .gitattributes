# Applied schema migrations are checksummed byte-for-byte (see cmdMigrate's
# checksum guard in brain.mjs). A line-ending change made by a different git
# client, editor, or `core.autocrlf` setting silently changes that checksum
# with no content difference at all, and cmdMigrate then refuses to run
# ANYTHING against that install until a human reconciles it by hand
# (`brain doctor <manifest> --repair-checksum`) — this is the confirmed cause
# of the one real field install stranded by this bug so far. Pinning these
# files to LF, on every platform, regardless of the local git config, is the
# cheapest way to stop a new instance of this from being created.
migrations/d1/*.sql text eol=lf

# The upload extractor build compares generated bytes exactly. Keep both the
# hashed source and committed generated output stable on Windows checkouts.
worker/build-src/lib/upload-extract.js text eol=lf
worker/src/lib/upload-extract.js text eol=lf

# Vite preserves carriage returns that occur inside multiline source strings.
# Pin the owner app source and its committed generated bundle to LF so Windows
# builds reproduce the exact reviewed JavaScript and CSS bytes.
frontend/** text=auto eol=lf
worker/src/lib/app-assets.js text eol=lf

# The bank-export Worker bundle also hashes its entry source and compares the
# generated bytes exactly. Keep both sides LF even when core.autocrlf is true.
ingest/bank-export.mjs text eol=lf
worker/src/lib/bank-export.js text eol=lf

# brain.mjs is read as TEXT by the suite, which anchors several structural
# assertions on "\n" (the command dispatch table, the guidance emission sites).
# With core.autocrlf on a Windows runner those regexes match nothing and the
# tests report the product has lost a table it still has. Pin it, the way the
# hashed files above are pinned, so every checkout sees the same bytes.
brain.mjs text eol=lf

# This fixture is compared by SHA-256 against the bytes published at the v0.2.0
# tag. A CRLF checkout changes the digest without changing a character of
# JSON, so the test then reports the published bytes as wrong.
test/fixtures/v0.2.0-brain.manifest.json text eol=lf

# This fixture is hashed against the exact MCP runtime published in v0.4.0
# through v0.4.5. Keep those evidence bytes stable on Windows checkouts too.
test/fixtures/published-v0.4.0-brain-mcp.mjs text eol=lf
