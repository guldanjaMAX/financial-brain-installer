<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Financial Brain $(var.PayloadVersion)" Manufacturer="Financial Brain LLC"
    Version="$(var.PayloadVersion)" UpgradeCode="A49C8F6E-AD20-4C23-89B7-0E2A5B63C02D"
    Scope="perUser" InstallerVersion="500" Compressed="yes" UpgradeStrategy="none">
    <MediaTemplate EmbedCab="yes" />
    <!-- MSI must resolve the same physical location during native uninstall,
         including a reviewed test install whose directory contains spaces. -->
    <Property Id="INSTALLFOLDER" Secure="yes">
      <RegistrySearch Id="InstalledPayloadDirectory" Root="HKCU"
        Key="Software\FinancialBrain\Payload\$(var.PayloadVersion)" Name="installDirectory" Type="raw" Bitness="always64" />
    </Property>
    <!-- Versions coexist. Never remove a working older version before the new
         payload passes verification. No RemoveExistingProducts action. -->
    <!-- VersionNT64 reports 603 on Windows 10 and 11. The earlier >= 1000
         guard refused supported PCs; read the real build number instead. -->
    <Property Id="WINDOWSBUILDNUMBER" Secure="yes">
      <RegistrySearch Id="WindowsBuildNumberSearch" Root="HKLM"
        Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion" Name="CurrentBuildNumber" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR (VersionNT64 AND WINDOWSBUILDNUMBER &gt;= 10240)"
      Message="Windows 10 or newer is required. No machine preparation was started." />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="OWNERROOT" Name="FinancialBrain">
        <Directory Id="APPROOT" Name="app">
          <Directory Id="INSTALLFOLDER" Name="$(var.PayloadVersion)" />
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Financial Brain">
        <Component Id="PayloadShortcut" Guid="*">
          <!-- PowerShell authenticates all local digests before private Node
               runs. The JS launcher repeats verification before the CLI. -->
          <Shortcut Id="SetupShortcut" Name="Financial Brain $(var.PayloadVersion) Setup"
            Description="Open Financial Brain setup using its private runtime"
            Target="[System64Folder]WindowsPowerShell\v1.0\powershell.exe"
            Arguments="-NoLogo -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]start-brain-setup.ps1&quot;"
            WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveMenu" On="uninstall" />
          <!-- Empty directory cleanup cannot delete owner state. Never add a
               wildcard RemoveFile or recursive RemoveFolderEx here. -->
          <RemoveFolder Id="RemoveAppRoot" Directory="APPROOT" On="uninstall" />
          <RemoveFolder Id="RemoveOwnerRootIfEmpty" Directory="OWNERROOT" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\FinancialBrain\Payload\$(var.PayloadVersion)" Name="installDirectory" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <Feature Id="Complete" Title="Financial Brain" Level="1">
      <ComponentGroupRef Id="VerifiedPayload" />
      <ComponentRef Id="PayloadShortcut" />
    </Feature>
  </Package>
</Wix>
